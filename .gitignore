# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.pytest_cache/

# Virtual environments & env
.venv
.xpu_venv
.env

# Ignore audio files globally by default
*.wav
*.mp3

# Ignore temporary audio history and generated files
outputs/generated/*.wav
outputs/generated/history.json

# EXCEPT cloned voice references and custom voices list (allow syncing across devices)
!outputs/references/*.wav
!outputs/references/*.mp3
!outputs/generated/custom_voices.json

# Finetune Data & Checkpoints
finetune/dataset/
finetune/output/

# Merged Models
merged_models_cache/
models_tts/
